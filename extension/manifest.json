{
  "manifest_version": 3,
  "name": "ReviewLens",
  "version": "1.0.0",
  "description": "AI-powered e-commerce review analysis",

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "*://www.amazon.in/*",
    "*://www.amazon.com/*",
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://www.amazon.in/*",
        "*://www.amazon.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}